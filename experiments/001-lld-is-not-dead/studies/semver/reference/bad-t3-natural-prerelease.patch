diff --git a/internal/natural.js b/internal/natural.js
new file mode 100644
index 0000000..257fb83
--- /dev/null
+++ b/internal/natural.js
@@ -0,0 +1,23 @@
+'use strict'
+
+// natural order for alphanumeric identifiers: digit runs compare as numbers
+const naturalCompare = (a, b) => {
+  const ra = String(a).match(/\d+|\D+/g)
+  const rb = String(b).match(/\d+|\D+/g)
+  for (let i = 0; i < ra.length && i < rb.length; i++) {
+    if (ra[i] !== rb[i]) {
+      if (/^\d/.test(ra[i]) && /^\d/.test(rb[i]) && +ra[i] !== +rb[i]) {
+        return +ra[i] < +rb[i] ? -1 : 1
+      }
+      if (!/^\d/.test(ra[i]) || !/^\d/.test(rb[i])) {
+        return ra[i] < rb[i] ? -1 : 1
+      }
+    }
+  }
+  if (ra.length !== rb.length) {
+    return ra.length < rb.length ? -1 : 1
+  }
+  return a === b ? 0 : a < b ? -1 : 1
+}
+
+module.exports = naturalCompare
