+export const winner = (board, win = board.length) => {
+  const size = board.length;
+  for (let r = 0; r < size; r++) {
+    for (let c = 0; c < size; c++) {
+      const first = board[r][c];
+      if (first === EMPTY) continue;
+      for (const [dr, dc] of DIRECTIONS) {
+        let k = 1;
+        while (
+          k < win &&
+          r + dr * k >= 0 && r + dr * k < size &&
+          c + dc * k >= 0 && c + dc * k < size &&
+          board[r + dr * k][c + dc * k] === first
+        ) k++;
+        if (k === win) return first;
+      }
+    }
   }
   return null;
 };
